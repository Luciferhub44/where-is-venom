# ── Paystack ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use the "Test" keys while developing, switch to "Live" keys in Vercel when ready to go live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the deployed site, used to build the Paystack callback_url.
# Set to http://localhost:3000 for local dev, and your real Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: Redis (live "cups sponsored" counter) ─────────────────────────
# Add a "Redis" storage integration (Upstash, via the Vercel Marketplace) from
# your Vercel project's Storage tab — it auto-fills these vars for you.
# Without them, the cups counter falls back to a static number in
# lib/campaign.ts and won't update live between serverless invocations, but
# checkout still works fine either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Legacy "Vercel KV" integrations use these names instead — either pair works)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Password for the donations/cup-purchases admin dashboard. Required for
# /admin to work; without it, the page always shows the login form and
# rejects every password. Pick a strong, unique value.
ADMIN_PASSWORD=

# ── Resend (donation & cup purchase confirmation emails) ────────────────────
# From https://resend.com/api-keys — needs send access on the verified
# whereisvenom.com domain. Without it, the webhook logs a warning and skips
# sending the confirmation email, but the payment itself still succeeds.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
